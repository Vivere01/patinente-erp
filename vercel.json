{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/assinar/:token", "destination": "/assinar.html?token=:token" },
    { "source": "/vistoria/:token", "destination": "/vistoria.html?token=:token" },
    { "source": "/vistoria", "destination": "/vistoria.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  }
}
