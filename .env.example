# Copie para .env.local (ou use `vercel env pull`) antes de rodar localmente.
#
# Conexão com o Postgres hospedado na Vercel (Marketplace → Neon/Postgres).
# No projeto da Vercel a variável já vem com esse nome quando o resource é conectado.
POSTGRES_URL=

# Segredo usado para assinar o login da loja e as URLs temporárias das fotos.
# Gere um valor longo e aleatório:  openssl rand -hex 32
AUTH_SECRET=

# Acesso da loja (email e senha do dono da operação).
# É o login que libera o aparelho; depois cada atendente entra com o PIN.
LOJA_EMAIL=
LOJA_SENHA=
